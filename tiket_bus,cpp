#include <iostream>
using namespace std;

// Fungsi menampilkan menu bus
void tampilMenu() {
    cout << "===== PEMESANAN TIKET BUS =====" << endl;
    cout << "1. Malang - Surabaya : Rp35.000" << endl;
    cout << "2. Malang - Pasuruan : Rp20.000" << endl;
    cout << "3. Malang - Jombang  : Rp25.000" << endl;
}

// Fungsi menentukan harga tiket
int hargaTiket(int pilihan) {
    switch (pilihan) {
        case 1: return 35000;
        case 2: return 20000;
        case 3: return 25000;
        default: return 0;
    }
}

// Fungsi menentukan tujuan
string tujuanBus(int pilihan) {
    switch (pilihan) {
        case 1: return "Malang - Surabaya";
        case 2: return "Malang - Pasuruan";
        case 3: return "Malang - Jombang";
        default: return "Tidak tersedia";
    }
}

int main() {
    int pilihan, jumlah, harga, total;

    tampilMenu();

    cout << "\nPilih tujuan (1-3): ";
    cin >> pilihan;

    harga = hargaTiket(pilihan);

    if (harga == 0) {
        cout << "Pilihan tujuan tidak tersedia!" << endl;
        return 0;
    }

    cout << "Jumlah penumpang: ";
    cin >> jumlah;

    if (jumlah <= 0) {
        cout << "Jumlah penumpang tidak valid!" << endl;
        return 0;
    }

    total = harga * jumlah;

    cout << "\n===== STRUK TIKET BUS =====" << endl;
    cout << "Tujuan          : " << tujuanBus(pilihan) << endl;
    cout << "Harga per tiket : Rp" << harga << endl;
    cout << "Jumlah penumpang: " << jumlah << endl;
    cout << "Total pembayaran: Rp" << total << endl;

    cout << "Terima kasih telah memesan!" << endl;

    return 0;
}
